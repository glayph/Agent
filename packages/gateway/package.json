{
  "name": "@miki/gateway",
  "version": "1.0.0",
  "description": "Lightweight Express gateway for Miki - proxies HTTP/WS to the core agent, serves static files, and provides health checks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.tsbuildinfo',{force:true})\"",
    "test": "vitest run src/monitor-history.test.ts src/plugin-management-router.test.ts src/health.test.ts src/global-resource-arbiter.test.ts src/host-resource-manager.test.ts src/agent-runtime-stream-retry.test.ts src/run-artifact-collector.test.ts"
  },
  "dependencies": {
    "@miki/config": "file:../config",
    "@miki/core": "file:../core",
    "@miki/memory": "file:../memory",
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.0",
    "qrcode": "^1.5.4",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
