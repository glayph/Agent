{
  "name": "@miki/core",
  "version": "1.0.0",
  "description": "Core agent engine for Miki - orchestrator, memory, LLM, tools, self-improvement, and governance",
  "type": "module",
  "main": "dist/api/index.js",
  "types": "dist/api/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./error-handler": {
      "import": "./dist/observability/error-handler.js",
      "types": "./dist/observability/error-handler.d.ts"
    },
    "./control": {
      "import": "./dist/control/index.js",
      "types": "./dist/control/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    },
    "./file-manager": {
      "import": "./dist/api/file-manager-router.js",
      "types": "./dist/api/file-manager-router.d.ts"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "types": "./dist/paths.d.ts"
    },
    "./permissions": {
      "import": "./dist/permissions/permission-ledger.js",
      "types": "./dist/permissions/permission-ledger.d.ts"
    },
    "./skills": {
      "import": "./dist/plugins/skills/index.js",
      "types": "./dist/plugins/skills/index.d.ts"
    },
    "./web-search-service": {
      "import": "./dist/services/web-search-service.js",
      "types": "./dist/services/web-search-service.d.ts"
    },
    "./api/goals": {
      "import": "./dist/api/goals-router.js",
      "types": "./dist/api/goals-router.d.ts"
    },
    "./api/link-preview": {
      "import": "./dist/api/link-preview.js",
      "types": "./dist/api/link-preview.d.ts"
    },
    "./speech-to-text": {
      "import": "./dist/services/speech-to-text.js",
      "types": "./dist/services/speech-to-text.d.ts"
    },
    "./self-improvement": {
      "import": "./dist/self-improvement/index.js",
      "types": "./dist/self-improvement/index.d.ts"
    },
    "./token-budget-manager": {
      "import": "./dist/engine/token-budget-manager.js",
      "types": "./dist/engine/token-budget-manager.d.ts"
    },
    "./autonomy": {
      "import": "./dist/autonomy/autonomous-supervisor.js",
      "types": "./dist/autonomy/autonomous-supervisor.d.ts"
    },
    "./autonomy/policy": {
      "import": "./dist/autonomy/autonomy-policy.js",
      "types": "./dist/autonomy/autonomy-policy.d.ts"
    },
    "./messaging": {
      "import": "./dist/messaging/index.js",
      "types": "./dist/messaging/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./mcp/connectors": {
      "import": "./dist/mcp/connectors.js",
      "types": "./dist/mcp/connectors.d.ts"
    },
    "./mcp/types": {
      "import": "./dist/mcp/types.js",
      "types": "./dist/mcp/types.d.ts"
    },
    "./task-coordinator": {
      "import": "./dist/tasks/task-coordinator.js",
      "types": "./dist/tasks/task-coordinator.d.ts"
    },
    "./plugins/providers": {
      "import": "./dist/plugins/providers/index.js",
      "types": "./dist/plugins/providers/index.d.ts"
    },
    "./plugins/providers/sdk": {
      "import": "./dist/plugins/providers/sdk/index.js",
      "types": "./dist/plugins/providers/sdk/index.d.ts"
    },
    "./plugins/providers/model-router": {
      "import": "./dist/plugins/providers/model-router.js",
      "types": "./dist/plugins/providers/model-router.d.ts"
    },
    "./tasks": {
      "import": "./dist/tasks/index.js",
      "types": "./dist/tasks/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./observability": {
      "import": "./dist/observability/index.js",
      "types": "./dist/observability/index.d.ts"
    },
    "./sessions": {
      "import": "./dist/sessions/session-history-store.js",
      "types": "./dist/sessions/session-history-store.d.ts"
    },
    "./plugins/tools": {
      "import": "./dist/plugins/tools/index.js",
      "types": "./dist/plugins/tools/index.d.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-llama.mjs && tsc -p tsconfig.json && node scripts/build-skill-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config=../../jest.core.config.cjs --runInBand --forceExit",
    "start": "node dist/api/index.js",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@miki/config": "file:../config",
    "@miki/memory": "file:../memory",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.0",
    "js-yaml": "^4.2.1",
    "openai": "^6.49.0",
    "playwright": "^1.44.0",
    "tar": "^7.5.22",
    "ws": "^8.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
