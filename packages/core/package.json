{
  "name": "@miki/core",
  "version": "1.0.0",
  "description": "Core agent engine for Miki - orchestrator, memory, LLM, tools, self-improvement, and governance",
  "type": "module",
  "main": "dist/api/index.js",
  "types": "dist/api/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./error-handler": {
      "import": "./dist/error-handler.js",
      "types": "./dist/error-handler.d.ts"
    },
    "./safety": {
      "import": "./dist/safety/index.js",
      "types": "./dist/safety/index.d.ts"
    },
    "./llm/provider": {
      "import": "./dist/llm/provider/index.js",
      "types": "./dist/llm/provider/index.d.ts"
    },
    "./llm/provider/sdk": {
      "import": "./dist/llm/provider/sdk/index.js",
      "types": "./dist/llm/provider/sdk/index.d.ts"
    },
    "./control": {
      "import": "./dist/control/index.js",
      "types": "./dist/control/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    },
    "./file-manager": {
      "import": "./dist/api/file-manager-router.js",
      "types": "./dist/api/file-manager-router.d.ts"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "types": "./dist/paths.d.ts"
    },
    "./skills": {
      "import": "./dist/skills-manager/index.js",
      "types": "./dist/skills-manager/index.d.ts"
    },
    "./web-search-service": {
      "import": "./dist/web-search-service.js",
      "types": "./dist/web-search-service.d.ts"
    },
    "./api/goals": {
      "import": "./dist/api/goals-router.js",
      "types": "./dist/api/goals-router.d.ts"
    },
    "./api/link-preview": {
      "import": "./dist/api/link-preview.js",
      "types": "./dist/api/link-preview.d.ts"
    },
    "./speech-to-text": {
      "import": "./dist/speech-to-text.js",
      "types": "./dist/speech-to-text.d.ts"
    },
    "./self-improvement": {
      "import": "./dist/self-improvement/index.js",
      "types": "./dist/self-improvement/index.d.ts"
    },
    "./memory-files": {
      "import": "./dist/memory-files/index.js",
      "types": "./dist/memory-files/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./autonomy": {
      "import": "./dist/autonomy/autonomous-supervisor.js",
      "types": "./dist/autonomy/autonomous-supervisor.d.ts"
    },
    "./autonomy/policy": {
      "import": "./dist/autonomy/autonomy-policy.js",
      "types": "./dist/autonomy/autonomy-policy.d.ts"
    },
    "./messaging": {
      "import": "./dist/messaging-adaptive.js",
      "types": "./dist/messaging-adaptive.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./mcp/connectors": {
      "import": "./dist/mcp/connectors.js",
      "types": "./dist/mcp/connectors.d.ts"
    },
    "./mcp/types": {
      "import": "./dist/mcp/types.js",
      "types": "./dist/mcp/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config=../../jest.core.config.cjs --runInBand --forceExit",
    "start": "node dist/api/index.js",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@miki/config": "file:../config",
    "@miki/installer": "file:../installer",
    "@miki/memory": "file:../memory",
    "@miki/skills": "file:../skills",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "https-proxy-agent": "^5.0.1",
    "js-yaml": "^4.2.1",
    "openai": "^4.52.0",
    "playwright": "^1.44.0",
    "qrcode": "^1.5.4",
    "tar": "^7.5.22",
    "telegraf": "^4.16.0",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "ws": "^8.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
