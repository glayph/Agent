{
  "manifest_version": 3,
  "name": "Miki Browser Agent",
  "version": "1.0.0",
  "description": "Connects a user's browser to their local Miki agent for browser control through an owner-paired local bridge.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*" }
}
