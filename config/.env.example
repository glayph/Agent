# Copy this file to config/.env and fill provider credentials only on your machine.
SUPPORTED_MODELS=llama.cpp/qwen2.5-0.5b-instruct-q4_k_m,gemini/gemini-3.5-flash-lite,openai/gpt-5-nano,openai/gpt-5-mini,openai/gpt-4o
MIKI_MODEL=llama.cpp/qwen2.5-0.5b-instruct-q4_k_m
DEFAULT_MODEL=llama.cpp/qwen2.5-0.5b-instruct-q4_k_m
MIKI_PROVIDER=llama.cpp
# Optional OpenAI-compatible low-cost fallback (keep disabled for local-only deployments).
# OPENAI_BASE_URL=https://your-compatible-endpoint/v1
# OPENAI_API_KEY=replace-me
# MIKI_CLOUD_FALLBACK=false

# Do not commit or share real values.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=
