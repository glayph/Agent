MIKI_MODEL=gemini/gemini-3.5-flash-lite
DEFAULT_MODEL=gemini/gemini-3.5-flash-lite
MIKI_PROVIDER=gemini

# Do not commit or share real values.
# GEMINI_API_KEY=
# MIKI_LLAMA_BASE_URL=http://127.0.0.1:39200/v1
# LLAMA_CPP_MODEL_PATH=/absolute/path/to/model.gguf
