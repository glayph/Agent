[Unit]
Description=Agent Miki self-healing gateway and local model runtime
After=network-online.target display-manager.service
Wants=network-online.target
# 0 disables systemd's start-rate limit: Miki is restarted for as long as the machine is up.
StartLimitIntervalSec=0

# The launcher owns the gateway, core, memory and llama.cpp child processes.
# systemd must manage the complete process group as one service.
[Service]
Type=simple
User=@MIKI_USER@
Group=@MIKI_GROUP@
WorkingDirectory=@MIKI_APP_ROOT@
EnvironmentFile=-@MIKI_ENV_FILE@
Environment=MIKI_SOURCE_ROOT=@MIKI_APP_ROOT@
Environment=MIKI_WORKSPACE_DIR=@MIKI_WORKSPACE_DIR@
Environment=MIKI_RUNTIME_ROOT=@MIKI_RUNTIME_ROOT@
# MIKI_24_7_RUNTIME is set only by scripts/miki-24-7.mjs. This unit is run by the launcher (bin/miki.js), which owns the
# hang watchdog for the gateway, so the gateway must not claim supervisor ownership here.
Environment=MIKI_24_7_ALLOW_UNLIMITED_RESTARTS=true
Environment=MIKI_24_7_READY_TIMEOUT_MS=45000
Environment=DISPLAY=@MIKI_DISPLAY@
Environment=XAUTHORITY=@MIKI_XAUTHORITY@
ExecStart=@MIKI_NODE_BIN@ @MIKI_APP_ROOT@/bin/miki.js
Restart=always
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=control-group

# Miki is a computer-using agent that runs inside a dedicated VM/sandbox, so the unit does not
# confine it with ProtectHome/ProtectSystem/PrivateTmp/NoNewPrivileges. The service user
# is the desktop user and DISPLAY/XAUTHORITY point at its X11 session for computer_* tools.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=append:@MIKI_LOG_DIR@/service.log
StandardError=append:@MIKI_LOG_DIR@/service-error.log

[Install]
WantedBy=multi-user.target
