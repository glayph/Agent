[Unit]
StartLimitIntervalSec=0
Description=Miki core API
PartOf=miki.target
After=network-online.target miki-llama.service
Wants=network-online.target miki-llama.service

[Service]
Type=simple
User=@MIKI_USER@
Group=@MIKI_GROUP@
WorkingDirectory=@MIKI_ROOT@
EnvironmentFile=-/etc/miki/miki.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=@MIKI_HOME@/.Xauthority
Environment=MIKI_GATEWAY_MANAGE_CORE=false
Environment=PATH=@MIKI_NODE_BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@MIKI_NODE@ @MIKI_ROOT@/packages/core/dist/api/index.js
Restart=always
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=25s
KillSignal=SIGTERM
SuccessExitStatus=0 143
# /usr, /boot and /etc become read-only for this service; the user's home stays writable. PrivateTmp is
# not set because computer_* tools reach the X11 socket in /tmp.
ProtectSystem=full
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G
CPUQuota=200%
TasksMax=512
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=miki.target
