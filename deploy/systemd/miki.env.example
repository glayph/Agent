# Template for /etc/miki/miki.env. scripts/install-systemd.sh fills in the @...@ placeholders
# (install root, service user's home, node binary). If you copy this file by hand, replace them yourself.
MIKI_ROOT=@MIKI_ROOT@
MIKI_WORKSPACE_DIR=@MIKI_ROOT@
MIKI_RUNTIME_ROOT=@MIKI_ROOT@
MIKI_SOURCE_ROOT=@MIKI_ROOT@
MIKI_NODE=@MIKI_NODE@

# Service ports
MEMORY_PORT=18700
CORE_PORT=8000
GATEWAY_PORT=18800
MIKI_LLAMA_PORT=39200
GATEWAY_HOST=127.0.0.1

# Browser origins (besides the dashboard itself) allowed to open the agent WebSocket.
# Comma separated, exact origins, no wildcards. Needed only if the page address differs from the
# Host header the gateway receives (e.g. a reverse proxy on a non-default port sending `Host $host`).
# MIKI_ALLOWED_ORIGINS=https://miki.example.com:8443

# Host names (besides localhost, IP addresses and this machine's own host name) that count as "this machine"
# for first-time setup and for the password-less agent WebSocket. Comma separated, no wildcards. This blocks
# DNS-rebinding pages, which reach the gateway through loopback under an attacker-controlled name.
# Needed only if you open the dashboard on this machine through another name, e.g. miki.lan.
# MIKI_ALLOWED_HOSTS=miki.lan

# The first dashboard password can only be set from the machine Miki runs on (or `curl` from its terminal).
# Set this to 1 ONLY if you must do that first-time setup through a browser from another machine or a
# reverse proxy, and remove it again right after - until a password exists, whoever gets there first owns the agent.
# MIKI_ALLOW_REMOTE_SETUP=1

# Local Gemma runtime
MIKI_LLAMA_SERVER_BIN=@MIKI_ROOT@/packages/core/dist/llm/local/native/linux-x64/llama-server
MIKI_LLAMA_MODEL_PATH=@MIKI_HOME@/.local/share/miki/models/google_gemma-4-E2B-it-Q4_0.gguf
MIKI_LLAMA_CONTEXT_SIZE=16384
MIKI_LLAMA_THREADS=4

# Gateway must not fork core when systemd owns the services.
MIKI_GATEWAY_MANAGE_CORE=false
CORE_MAX_RESTARTS=0
LOG_LEVEL=info
ENABLE_MCP=true

# Optional: shared secret for POST /api/webhooks/<name> (leave empty to disable webhook ingress)
# MIKI_WEBHOOK_SECRET=

# Recovery tuning (all optional; every number can be changed)
# MIKI_HEALTH_FAILURE_LIMIT=3          # failed 30 s checks in a row before a unit is restarted
# MIKI_LLAMA_LOAD_GRACE_SECONDS=600    # a llama server that reports "loading" is not restarted for this long
# MIKI_WATCHDOG_INTERVAL_MS=10000      # supervisor liveness probe interval
# MIKI_WATCHDOG_FAILURES=3             # failed probes in a row before the gateway is killed and restarted
# MIKI_OUTBOX_TTL_HOURS=24             # channel replies older than this are given up on
