# Copy to /etc/miki/miki.env and adjust paths if Miki is installed elsewhere.
MIKI_ROOT=/home/ubuntu/miki-final-2026-09-19
MIKI_WORKSPACE_DIR=/home/ubuntu/miki-final-2026-09-19
MIKI_RUNTIME_ROOT=/home/ubuntu/miki-final-2026-09-19
MIKI_SOURCE_ROOT=/home/ubuntu/miki-final-2026-09-19
MIKI_NODE=/usr/bin/node

# Service ports
MEMORY_PORT=18700
CORE_PORT=8000
GATEWAY_PORT=18800
MIKI_LLAMA_PORT=39200
GATEWAY_HOST=127.0.0.1

# Browser origins (besides the dashboard itself) allowed to open the agent WebSocket.
# Comma separated, exact origins, no wildcards. Needed only if the page address differs from the
# Host header the gateway receives (e.g. a reverse proxy on a non-default port sending `Host $host`).
# MIKI_ALLOWED_ORIGINS=https://miki.example.com:8443

# The first dashboard password can only be set from the machine Miki runs on (or `curl` from its terminal).
# Set this to 1 ONLY if you must do that first-time setup through a browser from another machine or a
# reverse proxy, and remove it again right after - until a password exists, whoever gets there first owns the agent.
# MIKI_ALLOW_REMOTE_SETUP=1

# Local Gemma runtime
MIKI_LLAMA_SERVER_BIN=/home/ubuntu/miki-final-2026-09-19/packages/core/dist/llm/local/native/linux-x64/llama-server
MIKI_LLAMA_MODEL_PATH=/home/ubuntu/.local/share/miki/models/google_gemma-4-E2B-it-Q4_0.gguf
MIKI_LLAMA_CONTEXT_SIZE=16384
MIKI_LLAMA_THREADS=4

# Gateway must not fork core when systemd owns the services.
MIKI_GATEWAY_MANAGE_CORE=false
CORE_MAX_RESTARTS=0
LOG_LEVEL=info
ENABLE_MCP=true
