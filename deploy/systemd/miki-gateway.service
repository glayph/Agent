[Unit]
StartLimitIntervalSec=0
Description=Miki gateway and dashboard
PartOf=miki.target
After=network-online.target miki-llama.service miki-core.service
Wants=network-online.target miki-llama.service miki-core.service

[Service]
Type=simple
User=@MIKI_USER@
Group=@MIKI_GROUP@
WorkingDirectory=@MIKI_ROOT@
EnvironmentFile=-/etc/miki/miki.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=@MIKI_HOME@/.Xauthority
Environment=MIKI_GATEWAY_MANAGE_CORE=false
Environment=PATH=@MIKI_NODE_BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@MIKI_NODE@ @MIKI_ROOT@/packages/gateway/dist/index.js
Restart=always
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=25s
KillSignal=SIGTERM
SuccessExitStatus=0 143
# The gateway runs the agent's terminal and computer_* tools as this user, with the user's own
# permissions and the desktop session (DISPLAY/XAUTHORITY), so it is deliberately NOT confined with
# ProtectSystem/ProtectHome/PrivateTmp/NoNewPrivileges: they would silently break those tools.
# (A ReadWritePaths= line here would do nothing without ProtectSystem=/ProtectHome=, so there is none.)
# Run Miki inside a VM/container, or as a dedicated unprivileged user, to limit what the agent can touch.
RestrictSUIDSGID=true
LockPersonality=true
CPUQuota=150%
TasksMax=512
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=miki.target
