[Unit]
StartLimitIntervalSec=120
StartLimitBurst=10
Description=Miki local llama.cpp Gemma server
PartOf=miki.target
After=local-fs.target miki-memory.service
Wants=miki-memory.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=@MIKI_ROOT@
EnvironmentFile=-/etc/miki/miki.env
ExecStart=@MIKI_ROOT@/packages/core/dist/llm/local/native/linux-x64/llama-server --host 127.0.0.1 --port 39200 --no-ui --model /home/ubuntu/.local/share/miki/models/google_gemma-4-E2B-it-Q4_0.gguf --alias local-model --ctx-size 16384 --threads 4
ExecStartPre=/usr/bin/test -x @MIKI_ROOT@/packages/core/dist/llm/local/native/linux-x64/llama-server
ExecStartPre=/usr/bin/test -f /home/ubuntu/.local/share/miki/models/google_gemma-4-E2B-it-Q4_0.gguf
Restart=always
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=20s
KillSignal=SIGTERM
SuccessExitStatus=0 143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@MIKI_ROOT@/data @MIKI_ROOT@/logs /home/ubuntu/.cache
MemoryMax=8G
CPUQuota=400%
TasksMax=256
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=miki.target
